module(name = "counterstrikesource-server")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_sourcemod", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.3.1")
bazel_dep(name = "rules_steam")
git_override(
    module_name = "rules_steam",
    commit = "cf093611289adae2d55bea927f9d8e9981c7403f",
    remote = "https://github.com/lanofdoom/rules_steam.git",
)

git_override(
    module_name = "rules_sourcemod",
    commit = "538e96463afb46c6afcbd2cf919b44cf9e33fe34",
    remote = "https://github.com/kleinpa/rules_sourcemod.git",
)

hl2sdk = use_extension("@rules_sourcemod//hl2sdk:repositories.bzl", "hl2sdk")
hl2sdk.branch(name = "css")
use_repo(hl2sdk, "hl2sdk_css")

sourcemod = use_extension("@rules_sourcemod//sourcemod:extensions.bzl", "sourcemod")
use_repo(sourcemod, "sourcemod_sdk")

# The image is built up from Debian packages rather than pulled from a
# published base, so nothing lands in it that the game binaries do not link
# against. See //base:trixie.yaml for the package list and how it was derived.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    name = "trixie",
    lock = "//base:trixie.lock.json",
    manifest = "//base:trixie.yaml",
)
use_repo(apt, "trixie")

steamapps = use_extension("//:steamapps.bzl", "steamapps_bzlmod")
use_repo(steamapps, "counterstrikesource_dedicated")

steamapps_launcher = use_extension("//:steamapps_launcher.bzl", "steamapps_launcher_bzlmod")
use_repo(
    steamapps_launcher,
    "steamworks_sdk_redist",
    "tf2_dedicated",
)

# Compiled from source instead of fetched as prebuilt release tarballs, so
# these stay reproducible from upstream source rather than a hand-built
# binary artifact.
extensions = use_extension("//:addons.bzl", "extensions")
use_repo(extensions, "auth_by_steam_group", "override_tickrate")

css_plugins = use_extension("//:addons.bzl", "css_plugins")
use_repo(
    css_plugins,
    "disable_buyzones",
    "disable_radar",
    "disable_round_timer",
    "ffa_spawns",
    "free_for_all",
    "gungame",
    "map_settings",
    "max_cash",
    "paintball",
    "remove_objectives",
    "respawn",
    "spawn_protection",
)

#
# Test Dependencies
#

PYTHON_VERSION = "3.13"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "counterstrikesource-server_pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//tests:requirements.txt",
)
use_repo(pip, "counterstrikesource-server_pypi")

#
# File Dependencies
#

# Use HTTP rules
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_git_repository(
    name = "counterstrikesource_maps",
    build_file_content = """
load("@@//:maps.bzl", "maps_archive")

maps_archive(
    name = "all_maps",
    srcs = glob(["**"], exclude = [".git/**", ".github/**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "3fd3fb1a04a59f8af59663ed73898eb46316d67e",
    remote = "https://github.com/lanofdoom/counterstrikesource-maps.git",
)
