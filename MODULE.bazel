module(name = "counterstrikesource-server")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_sourcemod", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_steam")
git_override(
    module_name = "rules_steam",
    commit = "5a2592be6f6a23013ce4af6d8c2665135626fad5",
    remote = "https://github.com/lanofdoom/rules_steam.git",
)

bazel_dep(name = "empty_team_bots", version = "1.1")
git_override(
    module_name = "empty_team_bots",
    commit = "04f07a3bab717e0d43adfde17026a65fc235bf6c",
    remote = "https://github.com/lanofdoom/empty-team-bots.git",
)

git_override(
    module_name = "rules_sourcemod",
    commit = "ee1f2ad7ea6280a524f36c6c1763c78ec1af4bb4",
    remote = "https://github.com/kleinpa/rules_sourcemod.git",
)

hl2sdk = use_extension("@rules_sourcemod//hl2sdk:repositories.bzl", "hl2sdk")
hl2sdk.branch(name = "css")
use_repo(hl2sdk, "hl2sdk_css")

sourcemod = use_extension("@rules_sourcemod//sourcemod:extensions.bzl", "sourcemod")
use_repo(sourcemod, "sourcemod_sdk")

# The image is built up from Debian packages rather than pulled from a
# published base, so nothing lands in it that the game binaries do not link
# against.
#
# The list is what `objdump -p` reports as NEEDED across srcds_linux64,
# bin/linux64/*.so, cstrike/bin/linux64/server_srv.so, the Steamworks redist and
# the Metamod/SourceMod binaries, mapped back to the packages that own them:
#
#   libc6      libc, libm, libdl, libpthread, librt, libmvec, ld-linux
#   libgcc-s1  libgcc_s.so.1
#   libstdc++6 libstdc++.so.6
#   zlib1g     libz.so.1
#
# Three NEEDED entries are deliberately absent, because the steamcmd image did
# not supply them either and the server runs regardless: libcurl-gnutls.so.4,
# which only replay_srv.so wants, and the libncurses.so.5/libtinfo.so.5 pair
# that dedicated_srv.so dlopens for its interactive console -- a dedicated
# server started without a tty never gets that far.
#
# Trixie rather than bookworm, and this is the pin that carries the build's ABI
# contract now that there is no pinned C++ toolchain.
#
# The Metamod and SourceMod addons are compiled by whoever runs the build and
# then dlopen'd by srcds in here, so this userland has to be at least as new as
# the glibc and libstdc++ they were compiled against. That direction is the safe
# one -- both libraries only ever add symbol versions, so an old binary runs
# against a new library, never the reverse. Valve's own binaries are from 2012
# and are the extreme case of that.
#
# Trixie's glibc 2.41 and libstdc++ 3.4.33 (GCC 14) clear a current build host
# with room to spare: a Fedora 42 toolchain emits nothing newer than GLIBC_2.38
# -- its headers redirect sscanf and strtol to the C23 variants added there --
# and GLIBCXX_3.4.30. Bookworm's glibc 2.36 did not clear it, which is what
# `Failed to load plugin "addons/metamod/bin/linux64/server"` was.
#
# So the maintenance rule is the inverse of the usual one: the snapshot below
# must move *forward* to stay ahead of the newest host anyone builds on. A host
# newer than what is pinned here shows up as Metamod or SourceMod failing to
# load, and `objdump -p` on the built .so files against the versions this ships
# names the symbol that did it.
#
# Snapshot URLs pin the archive to a point in time, so a resolution done today
# still succeeds after Debian publishes a new point release. Nothing updates
# the date automatically -- bump the two snapshot URLs below to pick up newer
# packages.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["trixie"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20260801T000000Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["trixie-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260801T000000Z"],
)
apt.install(
    dependency_set = "trixie",
    packages = [
        "ca-certificates",
        "libc6",
        "libgcc-s1",
        "libstdc++6",
        "zlib1g",
    ],
    suites = [
        "trixie",
        "trixie-security",
    ],
)
use_repo(apt, "trixie")

steamapps = use_extension("//:steamapps.bzl", "steamapps_bzlmod")
use_repo(steamapps, "counterstrikesource_dedicated")

steamapps_launcher = use_extension("//:steamapps_launcher.bzl", "steamapps_launcher_bzlmod")
use_repo(
    steamapps_launcher,
    "steamworks_sdk_redist",
    "tf2_dedicated",
)

# Compiled from source instead of fetched as prebuilt release tarballs, so
# these stay reproducible from upstream source rather than a hand-built
# binary artifact.
extensions = use_extension("//:addons.bzl", "extensions")
use_repo(extensions, "auth_by_steam_group", "override_tickrate")

css_plugins = use_extension("//:addons.bzl", "css_plugins")
use_repo(
    css_plugins,
    "disable_buyzones",
    "disable_radar",
    "disable_round_timer",
    "ffa_spawns",
    "free_for_all",
    "gungame",
    "map_settings",
    "max_cash",
    "paintball",
    "remove_objectives",
    "respawn",
    "spawn_protection",
)

#
# Test Dependencies
#

PYTHON_VERSION = "3.13"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "counterstrikesource-server_pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//tests:requirements.txt",
)
use_repo(pip, "counterstrikesource-server_pypi")

#
# File Dependencies
#

# Use HTTP rules
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_git_repository(
    name = "counterstrikesource_maps",
    build_file_content = """
load("@@//:maps.bzl", "maps_archive")

maps_archive(
    name = "all_maps",
    srcs = glob(["**"], exclude = [".git/**", ".github/**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "3fd3fb1a04a59f8af59663ed73898eb46316d67e",
    remote = "https://github.com/lanofdoom/counterstrikesource-maps.git",
)
