bazel_dep(name = "rules_sourcemod", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "rules_steam")
git_override(
    module_name = "rules_steam",
    commit = "60ca5cdb17d6418430204f6b4ec75b37bfcbb097",
    remote = "https://github.com/lanofdoom/rules_steam.git",
)

bazel_dep(name = "auth_by_steam_group")
git_override(
    module_name = "auth_by_steam_group",
    commit = "07ccde5763cb8b1c01f16564a8b9c3ac4df461ba",
    remote = "https://github.com/lanofdoom/auth-by-steam-group.git",
)

bazel_dep(name = "empty_team_bots")
git_override(
    module_name = "empty_team_bots",
    commit = "1143c6f02dcaa755b6a2aa540806fb9a421921f1",
    remote = "https://github.com/lanofdoom/empty-team-bots.git",
)

git_override(
    module_name = "rules_sourcemod",
    commit = "cf84d25b2153419b1caf311e55afe6514dbe64bd",
    remote = "https://github.com/kleinpa/rules_sourcemod.git",
)

register_toolchains("@rules_sourcemod//linux:all")

# The image is built up from Debian packages rather than pulled from a
# published base, so nothing lands in it that the game binaries do not link
# against.
#
# The list is what `objdump -p` reports as NEEDED across srcds_linux64,
# bin/linux64/*.so, cstrike/bin/linux64/server_srv.so, the Steamworks redist and
# the Metamod/SourceMod binaries, mapped back to the packages that own them:
#
#   libc6      libc, libm, libdl, libpthread, librt, libmvec, ld-linux
#   libgcc-s1  libgcc_s.so.1
#   libstdc++6 libstdc++.so.6
#   zlib1g     libz.so.1
#
# Three NEEDED entries are deliberately absent, because the steamcmd image did
# not supply them either and the server runs regardless: libcurl-gnutls.so.4,
# which only replay_srv.so wants, and the libncurses.so.5/libtinfo.so.5 pair
# that dedicated_srv.so dlopens for its interactive console -- a dedicated
# server started without a tty never gets that far.
#
# Debian stable. The Metamod and SourceMod addons are built with
# rules_sourcemod's hermetic toolchain (registered above) against a glibc 2.31 /
# GCC 10 sysroot, so they load on any userland at least that new regardless of
# which distro ran the build (rules_sourcemod's glibc_floor_test enforces it).
# Valve's own binaries are older still.
#
# Snapshot URLs pin the archive to a point in time, so a resolution done today
# still succeeds after Debian publishes a new point release. Nothing updates
# the date automatically -- bump both snapshot URLs below together to pick up
# newer packages and security fixes.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20261124T000000Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["trixie-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20261124T000000Z"],
)
apt.install(
    dependency_set = "trixie",
    packages = [
        "ca-certificates",
        "libc6",
        "libgcc-s1",
        "libstdc++6",
        "zlib1g",
    ],
    suites = [
        "trixie",
        "trixie-security",
        "trixie-updates",
    ],
)
use_repo(apt, "trixie")

steamapps = use_extension("//:steamapps.bzl", "steamapps_bzlmod")
use_repo(steamapps, "counterstrikesource_dedicated")

# Counter-Strike: Source ships a 64-bit engine (bin/linux64, and a 64-bit
# cstrike/bin/linux64/server_srv.so) but Valve never shipped the 64-bit
# launcher for it: depot 232336 contains only a 32-bit srcds_linux. The
# launcher is engine-generic, so it is taken from Team Fortress 2's dedicated
# server, which does ship one, along with the 64-bit libsteam_api.so that CS:S
# also omits.
steamapps_tf2 = use_extension("//:steamapps_tf2.bzl", "steamapps_bzlmod")
use_repo(steamapps_tf2, "tf2_dedicated")

# Steamworks SDK Redist, which is where a 64-bit steamclient.so comes from;
# CS:S only ships a 32-bit one.
steamapps_steamworks = use_extension("//:steamapps_steamworks.bzl", "steamapps_bzlmod")
use_repo(steamapps_steamworks, "steamworks_sdk_redist")

# All three steamapps*.bzl files are generated by update-steamapps.sh.

# Compiled from source instead of fetched as prebuilt release tarballs, so
# these stay reproducible from upstream source rather than a hand-built
# binary artifact.
addons = use_extension("//:addons.bzl", "addons")
use_repo(
    addons,
    "disable_buyzones",
    "disable_radar",
    "disable_round_timer",
    "ffa_spawns",
    "free_for_all",
    "gungame",
    "map_settings",
    "max_cash",
    "override_tickrate",
    "paintball",
    "remove_objectives",
    "respawn",
    "spawn_protection",
)

#
# Test Dependencies
#

PYTHON_VERSION = "3.13"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "counterstrikesource-server_pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//tests:requirements.txt",
)
use_repo(pip, "counterstrikesource-server_pypi")

#
# File Dependencies
#

# Use HTTP rules
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_git_repository(
    name = "counterstrikesource_maps",
    build_file_content = """
load("@@//:maps.bzl", "maps_archive")

maps_archive(
    name = "all_maps",
    srcs = glob(["**"], exclude = [".git/**", ".github/**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "3fd3fb1a04a59f8af59663ed73898eb46316d67e",
    remote = "https://github.com/lanofdoom/counterstrikesource-maps.git",
)
